<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:local="clr-namespace:Lecture03.MauiShowcase"
 xmlns:models="clr-namespace:Lecture03.MauiShowcase.Models"
 xmlns:converters="clr-namespace:Lecture03.MauiShowcase.Converters"
 x:Class="Lecture03.MauiShowcase.Pages.NewsPage" Title="Список новостей" x:DataType="{x:Null}">


 <!-- Строка * отдаёт списку оставшуюся высоту. CollectionView прокручивается сам, без внешнего ScrollView. -->
 <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
  
  <Label Text="Один шаблон — несколько новостей" Style="{StaticResource Heading}" />
  <Label Grid.Row="1" Text="CollectionView · ItemsSource · DataTemplate · SelectionChanged" />
  
  <CollectionView x:Name="NewsCollection" Grid.Row="2" SelectionMode="Multiple" SelectionChanged="OnNewsSelected">
   <CollectionView.ItemsLayout>
    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
   </CollectionView.ItemsLayout>
   <CollectionView.ItemTemplate>
    <!-- Шаблон описывает одну карточку. Её BindingContext — текущий NewsCard из ItemsSource; x:DataType задаёт тип для проверки привязок. -->
    <DataTemplate x:DataType="models:NewsCard">
     <Border Margin="2">
      <VerticalStackLayout Spacing="8">
       <!-- Без явного Source привязки читают свойства текущего объекта новости, а не всей страницы. -->
       <Label Text="{Binding Category}" FontSize="14" TextColor="#2563A6" />
       <Label Text="{Binding Title}" FontSize="21" FontAttributes="Bold" />
       <Label Text="{Binding Summary}" />
      </VerticalStackLayout>
     </Border>
    </DataTemplate>
   </CollectionView.ItemTemplate>
  </CollectionView>
  
  
  <Label x:Name="SelectionLabel" Grid.Row="3" Text="Выберите новость." />
 </Grid>
</ContentPage>
